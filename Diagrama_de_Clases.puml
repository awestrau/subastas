@startuml

skinparam linetype ortho
skinparam nodesep 100
skinparam ranksep 100
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package cr.ac.ucenfotec {
    class Main {
        + {static} main(args: String[])
    }
}

package cr.ac.ucenfotec.dl {
    class AccesoBD {
        - conexion: Connection
        - statement: Statement
        - preparedStatement: PreparedStatement
        + AccesoBD(direccion: String, usuario: String, password: String)
        + ejecutarStatement(statement: String)
        + ejecutarQuery(query: String): ResultSet
        + ejecutarStatementConRetornoId(query: String): int
    }
    class Conector {
        - {static} conexionBD: AccesoBD
        + {static} getConexion(): AccesoBD
    }
}

package cr.ac.ucenfotec.bl.dao {
    class DAOColeccionista {
        + {static} insertarColeccionista(coleccionista: Coleccionista): String
        + {static} listarColeccionistas(): ArrayList<Coleccionista>
    }
    class DAOModerador {
        + {static} insertarModerador(moderador: Moderador): String
        + {static} listarModeradores(): ArrayList<Moderador>
        + {static} existeModerador(): Boolean
    }
    class DAOObjeto {
        + {static} insertarObjeto(objeto: Objeto): String
        + {static} insertarYObtenerObjeto(objeto: Objeto): Objeto
        + {static} listarObjetos(): ArrayList<Objeto>
        + {static} actualizarEstado(id: int, nuevoEstado: String): String
    }
    class DAOOferta {
        + {static} registrarOferta(subasta: Subasta, oferente: Coleccionista, monto: double): String
        + {static} listarOfertasPorSubasta(idSubasta: int): ArrayList<Oferta>
        + {static} obtenerCantidadOfertas(idSubasta: int): int
        + {static} obtenerOfertaGanadora(idSubasta: int): Oferta
    }
    class DAOOrdenAdjudicacion {
        + {static} registrarOrden(orden: OrdenAdjudicacion): String
        + {static} listarOrdenes(): ArrayList<OrdenAdjudicacion>
    }
    class DAOSubasta {
        + {static} insertarSubasta(subasta: Subasta): String
        + {static} listarSubastas(): ArrayList<Subasta>
        + {static} actualizarEstado(id: int, vigente: boolean): String
    }
    class DAOVendedor {
        + {static} insertarVendedor(vendedor: Vendedor): String
        + {static} listarVendedores(): ArrayList<Vendedor>
    }
}

package cr.ac.ucenfotec.ui {
    class Menu {
        - {static} scanner: Scanner
        + {static} iniciar()
        - {static} verificarModerador()
        - {static} mostrarMenu()
        - {static} procesarOpcion(opcion: int)
        - {static} registrarUsuario(tipoForzado: int)
        - {static} listarUsuarios()
        - {static} leerEntero(mensaje: String): int
        - {static} leerFecha(mensaje: String): LocalDate
    }
}

package cr.ac.ucenfotec.tl {
    class Controlador {
        - {static} scanner: Scanner
        + {static} registrarUsuario(tipoForzado: int)
        + {static} listarUsuarios()
        + {static} existeModerador(): boolean
        + {static} crearObjeto()
        + {static} listarObjetos()
        + {static} actualizarEstadoObjeto()
        + {static} crearSubasta()
        + {static} listarSubastas()
        + {static} actualizarEstadoSubasta()
        + {static} crearOferta()
        + {static} listarOfertas()
        + {static} listarOrdenesAdjudicacion()
    }
}

package cr.ac.ucenfotec.bl.logic {
    class GestorSubastas {
        + {static} crearSubasta(creador: Coleccionista, precioMinimo: double, objetosSubastados: ArrayList<Objeto>): String
        + {static} crearSubasta(creador: Vendedor, precioMinimo: double, objetosSubastados: ArrayList<Objeto>): String
        + {static} listarSubastas(): ArrayList<Subasta>
        + {static} actualizarEstadoSubasta(id: int, vigente: boolean): String
    }

    class GestorUsuarios {
        - {static} usuarios: ArrayList<Usuario>
        + {static} existeModerador(): boolean
        - {static} validarEdadConfiguracion(fechaNacimiento: LocalDate)
        + {static} registrarModerador(nombre: String, id: String, password: String, fechaNacimiento: LocalDate, correo: String)
        + {static} registrarVendedor(nombre: String, id: String, password: String, fechaNacimiento: LocalDate, correo: String, puntuacionVendedor: int, direccion: String)
        + {static} registrarColeccionista(nombre: String, id: String, password: String, fechaNacimiento: LocalDate, correo: String, puntuacionColeccionista: int, direccion: String)
        + {static} listarUsuarios(): ArrayList<Usuario>
    }
    
    class GestorColeccionista {
        + {static} registrarColeccionista(nombre: String, id: String, password: String, fechaNacimiento: LocalDate, correo: String, puntuacion: int, direccion: String): String
        + {static} listarColeccionistas(): ArrayList<Coleccionista>
    }
    
    class GestorModerador {
        + {static} registrarModerador(nombre: String, id: String, password: String, fechaNacimiento: LocalDate, correo: String): String
        + {static} listarModeradores(): ArrayList<Moderador>
        + {static} existeModerador(): Boolean
    }
    
    class GestorVendedor {
        + {static} registrarVendedor(nombre: String, id: String, password: String, fechaNacimiento: LocalDate, correo: String, puntuacion: int, direccion: String): String
        + {static} listarVendedores(): ArrayList<Vendedor>
    }

    class GestorObjeto {
        + {static} crearObjeto(nombre: String, descripcion: String): String
        + {static} crearYObtenerObjeto(nombre: String, descripcion: String): Objeto
        + {static} listarObjetos(): ArrayList<Objeto>
        + {static} actualizarEstadoObjeto(id: int, estado: String): String
    }

    class GestorOferta {
        + {static} realizarOferta(oferente: Coleccionista, subasta: Subasta, monto: double): String
        + {static} listarOfertasPorSubasta(idSubasta: int): ArrayList<Oferta>
    }

    class GestorOrdenAdjudicacion {
        + {static} registrarOrdenAdjudicacion(idGanador: String, idSubasta: int, idOferta: int): String
        + {static} listarOrdenes(): ArrayList<OrdenAdjudicacion>
    }
}

package cr.ac.ucenfotec.bl.entities {
    enum EstadoSubasta <<enumeration>> {
        Programada
        Abierta
        Cerrada
    }

    class Objeto {
        # nombre: String
        # descripcion: String
        # estado: String
        # fechaCompra: LocalDate
        # antiguedad: String
        + Objeto(nombre: String, descripcion: String, estado: String, fechaCompra: LocalDate, antiguedad: String)
        + Objeto(nombre: String, descripcion: String)
        + getId(): int
        + setId(id: int)
        + getNombre(): String
        + setNombre(nombre: String)
        + getDescripcion(): String
        + setDescripcion(descripcion: String)
        + getEstado(): String
        + setEstado(estado: String)
        + getFechaCompra(): LocalDate
        + setFechaCompra(fechaCompra: LocalDate)
        + getAntiguedad(): String
        + setAntiguedad(antiguedad: String)
        + toString(): String
    }

    class Oferta {
        # oferente: Coleccionista
        # puntuacionOferente: double
        # precioOfertado: double
        + Oferta()
        + Oferta(oferente: Coleccionista, precioOfertado: double)
        + Oferta(idOferta: int, oferente: Coleccionista, precioOfertado: double)
        + getIdOferta(): int
        + getOferente(): Coleccionista
        + getPuntuacionOferente(): double
        + getPrecioOfertado(): double
        + setIdOferta(idOferta: int)
        + setOferente(oferente: Coleccionista)
        + setPuntuacionOferente(puntuacionOferente: double)
        + setPrecioOfertado(precioOfertado: double)
        + toString(): String
    }

    class OrdenAdjudicacion {
        # nombreGanador: String
        # fechaOrden: LocalDateTime
        # objetosAdjudicados: ArrayList<Objeto>
        # precioTotal: double
        + OrdenAdjudicacion()
        + OrdenAdjudicacion(idGanador: String, idSubasta: int, idOferta: int)
        + OrdenAdjudicacion(idOrden: int, idGanador: String, idSubasta: int, idOferta: int, fechaOrden: LocalDateTime)
        + getIdOrden(): int
        + getIdGanador(): String
        + getIdSubasta(): int
        + getIdOferta(): int
        + getFechaOrden(): LocalDateTime
        + setIdOrden(idOrden: int)
        + setIdGanador(idGanador: String)
        + setIdSubasta(idSubasta: int)
        + setIdOferta(idOferta: int)
        + setFechaOrden(fechaOrden: LocalDateTime)
        + toString(): String
    }

    class Subasta {
        # fechaVencimiento: LocalDateTime
        # TiempoParaVencer: Duration
        # creador: Usuario
        # calificacionCreador: double
        # precioMinimo: double
        # objetosSubastados: ArrayList<Objeto>
        # vigente: boolean
        # listaOfertas: ArrayList<Oferta>
        + Subasta(creador: Coleccionista, precioMinimo: double, objetosSubastados: ArrayList<Objeto>)
        + Subasta(creador: Vendedor, precioMinimo: double, objetosSubastados: ArrayList<Objeto>)
        + Subasta()
        + getId(): int
        + getFechaVencimiento(): LocalDateTime
        + getTiempoParaVencer(): Duration
        + getCreador(): Usuario
        + getCalificacionCreador(): double
        + getPrecioMinimo(): double
        + getObjetosSubastados(): ArrayList<Objeto>
        + isVigente(): boolean
        + setId(id: int)
        + setFechaVencimiento(fechaVencimiento: LocalDateTime)
        + setTiempoParaVencer(tiempoParaVencer: Duration)
        + setCreador(creador: Usuario)
        + setCalificacionCreador(calificacionCreador: double)
        + setPrecioMinimo(precioMinimo: double)
        + setObjetosSubastados(objetoSubastados: ArrayList<Objeto>)
        + setEstado(estado: boolean)
        + toString(): String
        + obtenerOfertaGanadora(): Oferta
        + actualizarVigencia()
    }
}

package cr.ac.ucenfotec.bl.entities.usuarios {
    abstract class Usuario {
        # nombre: String
        # id: String
        # fechaNacimiento: LocalDate
        # password: String
        # correo: String
        + Usuario()
        + Usuario(nombre: String, id: String, password: String, fechaNacimiento: LocalDate, correo: String)
        + getNombre(): String
        + setNombre(nombre: String)
        + getId(): String
        + setId(id: String)
        + getFechaNacimiento(): LocalDate
        + setFechaNacimiento(fechaNacimiento: LocalDate)
        + getEdad(): int
        + getPassword(): String
        + setPassword(password: String)
        + getCorreo(): String
        + setCorreo(correo: String)
        + toString(): String
    }

    class Coleccionista {
        # puntuacion: int
        # direccion: String
        # intereses: ArrayList<String>
        # objetos: ArrayList<Objeto>
        + Coleccionista()
        + Coleccionista(nombre: String, id: String, password: String, fechaNacimiento: LocalDate, correo: String, puntuacionColeccionista: int, direccion: String)
        + getPuntuacion(): int
        + setPuntuacion(puntuacion: int)
        + getDireccion(): String
        + setDireccion(direccion: String)
        + getIntereses(): ArrayList<String>
        + agregarIntereses(interes: String)
        + getObjetos(): ArrayList<Objeto>
        + agregarObjetos(objeto: Objeto)
        + toString(): String
    }

    class Moderador {
        + Moderador()
        + Moderador(nombre: String, id: String, password: String, fechaNacimiento: LocalDate, correo: String)
        + toString(): String
    }

    class Vendedor {
        # puntuacion: int
        # direccion: String
        + Vendedor()
        + Vendedor(nombre: String, id: String, password: String, fechaNacimiento: LocalDate, correo: String, puntuacionVendedor: int, direccion: String)
        + getPuntuacion(): int
        + setPuntuacion(puntuacionVendedor: int)
        + getDireccion(): String
        + setDireccion(direccion: String)
        + toString(): String
    }
}

' --- Relaciones y Layout ---

Main ..> Menu : inicia

Menu ..> Controlador : usa

Controlador ..> GestorSubastas : usa
Controlador ..> GestorUsuarios : usa
Controlador ..> GestorColeccionista : usa
Controlador ..> GestorModerador : usa
Controlador ..> GestorVendedor : usa
Controlador ..> GestorObjeto : usa
Controlador ..> GestorOferta : usa
Controlador ..> GestorOrdenAdjudicacion : usa

GestorSubastas ..> DAOSubasta : usa
GestorColeccionista ..> DAOColeccionista : usa
GestorModerador ..> DAOModerador : usa
GestorVendedor ..> DAOVendedor : usa
GestorObjeto ..> DAOObjeto : usa
GestorOferta ..> DAOOferta : usa
GestorOrdenAdjudicacion ..> DAOOrdenAdjudicacion : usa

DAOSubasta ..> AccesoBD : usa
DAOColeccionista ..> AccesoBD : usa
DAOModerador ..> AccesoBD : usa
DAOVendedor ..> AccesoBD : usa
DAOObjeto ..> AccesoBD : usa
DAOOferta ..> AccesoBD : usa
DAOOrdenAdjudicacion ..> AccesoBD : usa

AccesoBD ..> Conector : usa

GestorColeccionista o-- Coleccionista
GestorModerador o-- Moderador
GestorVendedor o-- Vendedor

GestorSubastas *-- Subasta
GestorObjeto *-- Objeto
GestorOferta *-- Oferta
GestorOrdenAdjudicacion *-- OrdenAdjudicacion

Usuario <|-- Coleccionista
Usuario <|-- Moderador
Usuario <|-- Vendedor

Subasta "1" *-- "*" Oferta : listaOfertas
Subasta "*" *-- "*" Objeto : objetosSubastados
Subasta --> Usuario : creador
Subasta ..> EstadoSubasta

Oferta --> Coleccionista : oferente

OrdenAdjudicacion "1" *-- "*" Objeto : objetos

Coleccionista "1" *-- "*" Objeto : objetos

@enduml
